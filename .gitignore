#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
*.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Flutter Windows desktop auto-generated plugin glue (regenerated by
# `flutter pub get`; tracking them caused persistent dirty-tree
# friction every push during the 2026-05-12 post-Codex wave).
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake

# Node local tooling
node_modules/

# Supabase local state (Supabase tooling retired 2026-04-26 in favor of
# Azure DB Flexible Server + plain Postgres Docker compose; entry kept
# during the 11a.11c.5 transition so any leftover .temp/ doesn't get
# committed before the supabase/ folder is removed)
supabase/.temp/

# Azure local state (Azure CLI cache, psql session artifacts)
.azure/
*.psql_history

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing
android/key.properties
android/app/upload-keystore.jks

# Local database
*.db

# Local secrets. The canonical local secret loader lives outside the repo at
# `$HOME/.forge_flow/forge_flow.secrets.ps1`; `.env.local` remains ignored
# if recreated for ad-hoc tooling.
.env
.env.local
.env.*.local
.env.example
.env.*.example
.env.local.example

# Firebase / Google Cloud private service-account material.
# Public client configs (`google-services.json`, `GoogleService-Info.plist`,
# `web/firebase-config.js`) may be committed; Admin SDK key JSON must not.
.firebase/
.forge_flow/
*firebase*service-account*.json
*firebase*adminsdk*.json

# Large binary assets
docs/internal/barrio/barrio_legado_business_plan.pdf

# Claude Code
.claude/

# Codex local tooling
.codex_appdata/
.codex_tmp_*

# Graphify generated output
graphify-out/

# Phase 2 pressure-harness generated artifacts (regenerated on every run)
test/integration/pressure/p2a_adapter_findings.jsonl
test/integration/pressure/p2b_*.jsonl
test/integration/pressure/p2c_*.jsonl
test/integration/pressure/p2d_*.jsonl

# Kotlin compiler sessions
android/.kotlin/

# Personal outreach / drafts (not for repo)
Selling.md

# Obsidian vault config (not for repo)
.obsidian/

# Scratch research dumps from other projects (root-anchored)
/ha_*
/pd_*
/po_*
/ppa_*
/rmm_*
/smp_*
/tc_*

# Project-scoped MCP server registration (machine-specific absolute paths)
.mcp.json

# Pressure preview v1 — per-run findings JSONL and summary artifacts.
# These are local diagnostic outputs; PR bodies carry the human-readable
# summary, the JSONL stays untracked.
test/integration/pressure/*_findings.jsonl
test/integration/pressure/*_summary.md
test/pressure/*_findings.jsonl
test/pressure/*_summary.md
test/pressure/*_raw.jsonl
