# syntax=docker/dockerfile:1
#
# Phase 11A.0 — Admin console (Flutter Web) container.
#
# Builds `lib/main_admin.dart` for web and serves the static bundle
# behind nginx. Targets the separate Cloud Run service that lives at
# `admin.forgeflow.app`. Distinct from the operator proxy `Dockerfile`
# (Dart server image) — this image is intentionally a static-asset
# container so the admin console scales independently and has no
# Dart runtime dependency at serve time.
#
# Default build = live Firebase admin auth. The compiled bundle calls
# `Firebase.initializeApp(options: kAdminFirebaseOptions)` and admits
# Firebase users whose ID-token custom claims set
# `is_super_admin: true` or `is_ff_support: true`. Everything else
# fail-closes to the forbidden surface.
#
# Demo opt-in (LOCAL ONLY — do NOT use for a public Cloud Run
# deploy): `--build-arg ADMIN_DEMO_AUTH=true`. Demo auth on a
# publicly-routed `--allow-unauthenticated` Cloud Run service is a
# privilege bypass; the deploy script only honours it behind a
# loud `-DemoMode` switch. The separate share-preview build also
# enables demo auth, but starts as read-only ff_support and binds no
# live proxy or staging data.
#
# Build (live, default):
#   docker build -f Dockerfile.admin_console \
#     --build-arg ADMIN_PROXY_BASE_URI=https://admin-proxy.forgeflow.app \
#     -t forge-flow-admin-console .
# Build (demo, local sandbox only):
#   docker build -f Dockerfile.admin_console \
#     --build-arg ADMIN_DEMO_AUTH=true \
#     -t forge-flow-admin-console-demo .

FROM ghcr.io/cirruslabs/flutter:stable AS build

# Default = live Firebase admin auth. Set to `true` ONLY for a
# local sandbox build; never set true in a Cloud Run deploy without
# the corresponding deploy-script `-DemoMode` warning path.
ARG ADMIN_DEMO_AUTH=false
ARG ADMIN_SHARE_PREVIEW=false
ARG ADMIN_PROXY_BASE_URI=
ARG FIREBASE_WEB_API_KEY=
ARG FIREBASE_WEB_APP_ID=
ARG FIREBASE_MESSAGING_SENDER_ID=
ARG FIREBASE_PROJECT_ID=
ARG FIREBASE_AUTH_DOMAIN=
ARG FIREBASE_STORAGE_BUCKET=
ARG ADMIN_BUILD_FLAVOR=admin

WORKDIR /workspace

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY lib ./lib
COPY assets ./assets
COPY web ./web
COPY analysis_options.yaml ./analysis_options.yaml

RUN if [ "${ADMIN_DEMO_AUTH}" != "true" ] && [ -z "${ADMIN_PROXY_BASE_URI}" ]; then \
        echo "ADMIN_PROXY_BASE_URI build arg is required when ADMIN_DEMO_AUTH=false"; \
        exit 1; \
    fi

RUN flutter config --enable-web \
    && flutter build web \
        --target=lib/main_admin.dart \
        --release \
        --no-web-resources-cdn \
        --dart-define=ADMIN_DEMO_AUTH=${ADMIN_DEMO_AUTH} \
        --dart-define=ADMIN_SHARE_PREVIEW=${ADMIN_SHARE_PREVIEW} \
        --dart-define=ADMIN_PROXY_BASE_URI=${ADMIN_PROXY_BASE_URI} \
        --dart-define=FIREBASE_WEB_API_KEY=${FIREBASE_WEB_API_KEY} \
        --dart-define=FIREBASE_WEB_APP_ID=${FIREBASE_WEB_APP_ID} \
        --dart-define=FIREBASE_MESSAGING_SENDER_ID=${FIREBASE_MESSAGING_SENDER_ID} \
        --dart-define=FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID} \
        --dart-define=FIREBASE_AUTH_DOMAIN=${FIREBASE_AUTH_DOMAIN} \
        --dart-define=FIREBASE_STORAGE_BUCKET=${FIREBASE_STORAGE_BUCKET}

FROM nginx:1.27-alpine

COPY --from=build /workspace/build/web /usr/share/nginx/html

# Precompress the Flutter web bundle at image build time so nginx can serve
# the large admin assets without spending request-path CPU on gzip work.
RUN find /usr/share/nginx/html -type f \( \
        -name '*.js' -o \
        -name '*.css' -o \
        -name '*.json' -o \
        -name '*.wasm' -o \
        -name '*.svg' \
    \) -exec sh -c 'gzip -9 -c "$1" > "$1.gz"' _ {} \;

# Cloud Run honours $PORT; rewrite the default nginx listener so the
# container binds wherever Cloud Run schedules it. Index fallback
# keeps Flutter's hash-based deep links working when an admin
# refreshes mid-route.
RUN printf '%s\n' \
        'server {' \
        '    listen 0.0.0.0:8080;' \
        '    listen [::]:8080;' \
        '    gzip on;' \
        '    gzip_static on;' \
        '    gzip_comp_level 6;' \
        '    gzip_min_length 1024;' \
        '    gzip_proxied any;' \
        '    gzip_vary on;' \
        '    gzip_types application/javascript application/json application/wasm font/ttf font/otf font/woff font/woff2 image/svg+xml text/css text/javascript text/plain;' \
        '    add_header Cache-Control "no-store, max-age=0" always;' \
        '    root /usr/share/nginx/html;' \
        '    index index.html;' \
        '    location / {' \
        '        try_files $uri $uri/ /index.html;' \
        '    }' \
        '}' \
    > /etc/nginx/conf.d/default.conf

ENV PORT=8080
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
