# syntax=docker/dockerfile:1
#
# Phase 11W.0 — Operator Web Console (Flutter Web) container.
#
# Builds `lib/main_operator_web.dart` for web and serves the static
# bundle behind nginx. Targets the separate Cloud Run service that
# lives at `app.forgeflow.app`. Distinct from:
#
#   * `Dockerfile`              — operator-app proxy (Dart server image)
#   * `Dockerfile.admin_console` — F&F Operations Console (Phase 11A)
#
# Both web-static images are intentionally nginx-only (no Dart runtime
# at serve time) so each web surface scales independently and has no
# server-side Azure connection — no static-egress IP / VPC connector
# required for `11W.0` (matches Phase 11A.0 posture; `11W.7`/`11W.8`
# may add server-side calls later, in which case revisit this).
#
# Default build = live Firebase auth. The compiled bundle calls
# `Firebase.initializeApp(options: kOperatorWebFirebaseOptions)` and
# routes the operator through password / MFA / T&Cs. Live mode also
# requires `OPERATOR_WEB_PROXY_BASE_URI` to be compiled in so the
# auth source can reach the existing advisor proxy; the deploy script
# refuses to publish a live build that would silently fall back to
# fixtures.
#
# Demo opt-in (LOCAL ONLY — do NOT use for a public Cloud Run
# deploy): `--build-arg OPERATOR_WEB_DEMO_AUTH=true`. Demo auth on a
# publicly-routed `--allow-unauthenticated` Cloud Run service is a
# privilege bypass; the deploy script only honours it behind a loud
# `-DemoMode` switch.
#
# Build (live, default):
#   docker build -f Dockerfile.operator_web \
#     --build-arg OPERATOR_WEB_PROXY_BASE_URI=https://proxy.forgeflow.app \
#     -t forge-flow-operator-web .
# Build (demo, local sandbox only):
#   docker build -f Dockerfile.operator_web \
#     --build-arg OPERATOR_WEB_DEMO_AUTH=true \
#     -t forge-flow-operator-web-demo .

FROM ghcr.io/cirruslabs/flutter:stable AS build

# Default = live Firebase auth. Set to `true` ONLY for a local
# sandbox build; never set true in a Cloud Run deploy without the
# corresponding deploy-script `-DemoMode` warning path.
ARG OPERATOR_WEB_DEMO_AUTH=false
ARG OPERATOR_WEB_PROXY_BASE_URI=
ARG OPERATOR_WEB_BUILD_FLAVOR=operator_web

WORKDIR /workspace

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY lib ./lib
COPY assets ./assets
COPY web ./web
COPY analysis_options.yaml ./analysis_options.yaml

RUN if [ "${OPERATOR_WEB_DEMO_AUTH}" != "true" ] && [ -z "${OPERATOR_WEB_PROXY_BASE_URI}" ]; then \
        echo "OPERATOR_WEB_PROXY_BASE_URI build arg is required when OPERATOR_WEB_DEMO_AUTH=false"; \
        exit 1; \
    fi

# Swap the operator-web web shell into place. The repo carries the
# admin / operator-app web shell at `web/` (used by `Dockerfile` and
# `Dockerfile.admin_console`); the operator-web shell (correct
# `<title>` + manifest + favicon) lives at `web/operator/`. Flutter's
# `build web` command does not yet support `--web-resources-dir`, so
# we overlay the operator-web files onto `web/` inside the build
# container — the source tree on disk stays unchanged because `COPY`
# brought in a fresh copy.
RUN cp web/operator/index.html web/index.html \
    && cp web/operator/manifest.json web/manifest.json \
    && cp web/operator/favicon.png web/favicon.png \
    && cp -f web/operator/icons/Icon-192.png web/icons/Icon-192.png \
    && cp -f web/operator/icons/Icon-512.png web/icons/Icon-512.png \
    && cp -f web/operator/icons/Icon-maskable-192.png web/icons/Icon-maskable-192.png \
    && cp -f web/operator/icons/Icon-maskable-512.png web/icons/Icon-maskable-512.png

RUN flutter config --enable-web \
    && flutter build web \
        --target=lib/main_operator_web.dart \
        --output=build/operator_web \
        --release \
        --dart-define=OPERATOR_WEB_DEMO_AUTH=${OPERATOR_WEB_DEMO_AUTH} \
        --dart-define=OPERATOR_WEB_PROXY_BASE_URI=${OPERATOR_WEB_PROXY_BASE_URI}

FROM nginx:1.27-alpine

COPY --from=build /workspace/build/operator_web /usr/share/nginx/html

# Cloud Run honours $PORT; rewrite the default nginx listener so the
# container binds wherever Cloud Run schedules it. Index fallback
# keeps Flutter's hash-based deep links working when an operator
# refreshes mid-route (e.g. mid-onboarding).
RUN printf '%s\n' \
        'server {' \
        '    listen 0.0.0.0:8080;' \
        '    listen [::]:8080;' \
        '    gzip on;' \
        '    gzip_comp_level 6;' \
        '    gzip_min_length 1024;' \
        '    gzip_proxied any;' \
        '    gzip_vary on;' \
        '    gzip_types application/javascript application/json application/wasm font/ttf font/otf font/woff font/woff2 image/svg+xml text/css text/javascript text/plain;' \
        '    add_header Cache-Control "no-store, max-age=0" always;' \
        '    root /usr/share/nginx/html;' \
        '    index index.html;' \
        '    location / {' \
        '        try_files $uri $uri/ /index.html;' \
        '    }' \
        '}' \
    > /etc/nginx/conf.d/default.conf

ENV PORT=8080
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
