#!/bin/sh
# Cheap Forge & Flow repo lints before pushing. This is deliberately not
# flutter analyze/test, browser QA, provider work, graph work, or cloud work.

set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
repo_root_posix=$(printf '%s' "$repo_root" | tr '\\' '/')

case "$repo_root_posix" in
  */.claude/worktrees/*|*/.codex_worktrees/*)
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
    case "$branch" in
      claude/*|codex/*|claude2/*|codex2/*)
        # Agent worktree pushing its own agent branch -- push allowed.
        # Agents commit + push + open PR; main audits PR against contracts
        # before merging to master. See workflow notes in CLAUDE.md.
        # `claude2/`/`codex2/` lanes match the Wave 2 orchestrator naming.
        ;;
      *)
        echo "[forge-flow pre-push] Refusing to push from an agent worktree on non-agent branch:"
        echo "  $repo_root"
        echo "  branch: ${branch:-<detached>}"
        echo "Agent worktrees may only push claude/* or codex/* branches."
        exit 1
        ;;
    esac
    ;;
esac

cd "$repo_root" || exit 1

if [ "${FORGE_FLOW_SKIP_PRE_PUSH_LINTS:-}" = "1" ]; then
  echo "[forge-flow pre-push] Skipping repo lints because FORGE_FLOW_SKIP_PRE_PUSH_LINTS=1."
  exit 0
fi

changed_files=""
zero_sha=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "${remote_sha:-$zero_sha}" = "$zero_sha" ]; then
    base=$(git merge-base "$local_sha" origin/master 2>/dev/null || true)
    if [ -z "$base" ]; then
      base=$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | tail -n 1)
    fi
    files=$(git diff --name-only "$base..$local_sha" 2>/dev/null || true)
  else
    files=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  if [ -n "$files" ]; then
    changed_files="$changed_files
$files"
  fi
done

if [ -z "$changed_files" ]; then
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [ -n "$upstream" ]; then
    changed_files=$(git diff --name-only "${upstream}...HEAD" 2>/dev/null || true)
  fi
fi

changed_files=$(printf '%s\n' "$changed_files" | sed '/^[[:space:]]*$/d' | sort -u)

if [ -z "$changed_files" ]; then
  echo "[forge-flow pre-push] No pushed file changes detected; skipping scoped repo lints."
  exit 0
fi

has_changed() {
  printf '%s\n' "$changed_files" | grep -Eq "$1"
}

echo "[forge-flow pre-push] Running scoped cheap repo lints..."
status=0
ran=0

run_lint() {
  ran=1
  echo
  echo "+ $*"
  "$@" || status=1
}

if has_changed '\.dart$|^pubspec\.yaml$|^pubspec\.lock$'; then
  run_lint dart run tool/postgres_import_lint.dart
fi

if has_changed '^db/migrations/.*\.sql$|^tool/index_leading_column_lint\.dart$'; then
  run_lint dart run tool/index_leading_column_lint.dart
fi

if has_changed '^lib/auth/permission_keys\.dart$|^docs/contracts/auth_permission_key_catalog\.md$|^tool/permission_key_lint\.dart$'; then
  run_lint dart run tool/permission_key_lint.dart
fi

if has_changed '^db/migrations/.*\.sql$|^scripts/postgres_staging_setup\.ps1$|^tool/migration_cutoff_lint\.dart$'; then
  run_lint dart run tool/migration_cutoff_lint.dart
fi

if has_changed '^\.github/workflows/|^tool/release_dart_defines_lint\.dart$'; then
  run_lint dart run tool/release_dart_defines_lint.dart
fi

if has_changed '^\.github/workflows/|^Dockerfile|^cloudbuild|^tool/release_build_demo_flag_lint\.dart$'; then
  run_lint dart run tool/release_build_demo_flag_lint.dart
fi

if has_changed '^web/index.*\.html$|^tool/csp_header_lint\.dart$'; then
  run_lint dart run tool/csp_header_lint.dart
fi

if has_changed '^\.github/workflows/|^tool/actions_pinning_lint\.dart$'; then
  run_lint dart run tool/actions_pinning_lint.dart
fi

if has_changed '^db/migrations/.*\.sql$|^tool/rls_policy_lint\.dart$|^tool/rls_policy_lint_allowlist\.txt$'; then
  run_lint dart run tool/rls_policy_lint.dart
fi

# UX no-em-dash law: operator-facing copy never uses an em dash. Scoped
# to the rendering/content layers ux_em_dash_lint.dart enforces.
if has_changed '^lib/screens/|^lib/widgets/|^lib/operator_web/|^lib/admin/screens/|^lib/admin/widgets/|^lib/admin/admin_routes\.dart$|^lib/domain/constants/app_defaults\.dart$|^lib/services/email/|^lib/infrastructure/persistence/sqlite/sqlite_database\.dart$|^lib/dev/demo_vendor_integration_state_fixture\.dart$|^tool/ux_em_dash_lint\.dart$'; then
  run_lint dart run tool/ux_em_dash_lint.dart
fi

# Barrio generated-content drift: lib/internal/barrio/content/training/**
# is generator OUTPUT. If a source markdown or a manifest moved without a
# regenerate, or a generated .dart was hand-edited, the next clean
# generator run silently reverts curated work (that is how 44 culled
# photos came back after PR #1534). --check renders in memory and
# compares; it writes nothing. ~0.4s. Skipped when no working python is
# available so a python-less clone can still push; the probe runs an
# actual interpreter rather than trusting PATH, because the Windows Store
# `python` stub resolves on PATH and then refuses to run.
if has_changed '^lib/internal/barrio/content/training/.*\.dart$|^tool/barrio_training_content_generator\.py$|^tool/barrio_training_(diagrams_manifest|card_titles|image_removals)\.json$|^docs/Knowledge_graph_docs/'; then
  barrio_py=""
  for candidate in python python3 py; do
    if "$candidate" -c "" >/dev/null 2>&1; then
      barrio_py="$candidate"
      break
    fi
  done
  if [ -n "$barrio_py" ]; then
    run_lint "$barrio_py" tool/barrio_training_content_generator.py --check
  else
    echo
    echo "[forge-flow pre-push] No working python found; skipping barrio content drift check."
    echo "  Run it manually: python tool/barrio_training_content_generator.py --check"
  fi
fi

# Barrio extractor safety: assets/internal/barrio/training/<doc_id>/ has two
# writers (this extractor and the real-images pass), so the extractor may only
# delete files its manifest says it produced. Getting that wrong destroyed 127
# tracked assets and 8 docs' markers on clean master (2026-08-06). The test
# builds a synthetic PDF in a temp dir, so unlike the extractor's own --check
# it does not need the untracked docs/training drop. ~2s.
if has_changed '^tool/barrio_training_image_extractor(_test)?\.py$|^tool/barrio_training_extracted_assets\.json$'; then
  barrio_ex_py=""
  for candidate in python python3 py; do
    if "$candidate" -c "" >/dev/null 2>&1; then
      barrio_ex_py="$candidate"
      break
    fi
  done
  if [ -n "$barrio_ex_py" ]; then
    run_lint "$barrio_ex_py" tool/barrio_training_image_extractor_test.py
  else
    echo
    echo "[forge-flow pre-push] No working python found; skipping barrio extractor test."
    echo "  Run it manually: python tool/barrio_training_image_extractor_test.py"
  fi
fi

# Ignore-justification bar: every `// ignore:` carries rationale, not
# just the diagnostic name. Scoped to lib/** + tool/** Dart sources.
if has_changed '^lib/.*\.dart$|^tool/.*\.dart$'; then
  run_lint dart run tool/ignore_justification_lint.dart
fi

# Refactor-phase anti-regrowth: the tracked operator-web / admin
# god-screens must not grow past their frozen ceilings (lowered as they
# decompose, never raised without operator approval). Fast: line counts.
if has_changed '^lib/admin/screens/|^lib/admin/admin_routes\.dart$|^lib/operator_web/|^tool/operator_web_size_lint\.dart$'; then
  run_lint dart run tool/operator_web_size_lint.dart
fi

# Refactor-phase metrics ratchet: function-count warnings/alarms (SLOC,
# complexity, params, nesting) only ever go DOWN. Baseline in
# tool/metrics_ratchet_baseline.json; raising any number needs operator
# approval (CLAUDE.md Ceiling-raise rule R-2).
if has_changed '^lib/.*\.dart$|^tool/metrics_ratchet_check\.dart$|^tool/metrics_ratchet_baseline\.json$|^analysis_options\.yaml$'; then
  run_lint dart run tool/metrics_ratchet_check.dart
fi

# Bleed-stop ceiling for the advisor proxy monolith. The kAdvisorProxyMaxLines
# constant is a freeze (CLAUDE.md "Ceiling-raise rule R-2") — raising needs
# explicit operator approval, same gate as auth/RLS/schema/proxy slices.
if has_changed '^tool/advisor_proxy/.*\.dart$|^tool/advisor_proxy_size_lint\.dart$'; then
  run_lint dart run tool/advisor_proxy_size_lint.dart
fi

# Skip-quarantine bar: every skipped test is self-documenting (env gate)
# or has a docs/KNOWN_FAILING_TESTS.md row. Fast: scans test/ skip sites.
if has_changed '^test/.*\.dart$|^docs/KNOWN_FAILING_TESTS\.md$|^tool/skip_quarantine_lint\.dart$'; then
  run_lint dart run tool/skip_quarantine_lint.dart
fi

if has_changed '^lib/integrations/|^tool/advisor_proxy/.*integrations|^docs/integrations/|^tool/vendor_completeness_lint\.dart$'; then
  run_lint dart run tool/vendor_completeness_lint.dart
fi

if [ "$ran" -eq 0 ]; then
  echo "[forge-flow pre-push] Pushed files do not require scoped repo lints."
  exit 0
fi

if [ "$status" -ne 0 ]; then
  echo
  echo "[forge-flow pre-push] One or more cheap repo lints failed."
  echo "Fix the reported issue, or use FORGE_FLOW_SKIP_PRE_PUSH_LINTS=1 only for an explicit operator-approved emergency."
  exit "$status"
fi

echo
echo "[forge-flow pre-push] Repo lints passed."
exit 0
